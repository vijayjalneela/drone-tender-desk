# Copy to .env and fill in. Never commit .env.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tender_desk
TEST_DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tender_desk_test
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# Uploaded PDFs are stored in the database; there is no file-storage setting.
# Not used yet (the extractor is a stub)
ANTHROPIC_API_KEY=

# --- Frontend (read by Vite at build time; no /api suffix) ---
VITE_API_BASE_URL=http://localhost:8000
